# ---- Shared / Docker Compose ----
MONGO_INITDB_ROOT_USERNAME=rpa
MONGO_INITDB_ROOT_PASSWORD=rpa_dev_password
MONGO_PORT=27017

# ---- apps/api ----
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://rpa:rpa_dev_password@mongo:27017/rapid_prototype_assistant?authSource=admin

JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# OAuth (optional — leave blank to disable; see apps/api/src/auth/README.md)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:4000/auth/github/callback

CORS_ORIGIN=http://localhost:5173

# Anthropic — required for the lifecycle stages to actually reason.
# Model routing per the PRD: Opus for judgment stages, Sonnet for execution stages.
# Update these two IDs to whatever current model identifiers your account has access to.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_OPUS=claude-opus-4-6
ANTHROPIC_MODEL_SONNET=claude-sonnet-4-6

# Optional: overrides EVERY stage's max output tokens (each stage otherwise
# has its own budget in apps/api/src/common/lifecycle/stage-definitions.ts —
# BUILD and FIX default much higher than the others since they emit full
# source files). Set this if a stage's response keeps getting cut off (a 503
# "cut off because it hit the token output limit" error) and raising the
# per-stage value in code isn't convenient, or set it LOWER if your account's
# model rejects the defaults with an "max_tokens too large" error.
# ANTHROPIC_MAX_TOKENS=16000

# ---- apps/web ----
VITE_API_BASE_URL=http://localhost:4000
